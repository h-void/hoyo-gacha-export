{
  "name": "hoyo-gacha-export",
  "version": "1.1.1",
  "description": "Unified 4-in-1 HoYoverse gacha history exporter for Genshin Impact, Honkai: Star Rail, Zenless Zone Zero, and Miliastra Wonderland (千星奇域).",
  "main": "./dist/electron/main/main.js",
  "author": "h-void <118628214+h-void@users.noreply.github.com>",
  "contributors": [
    "biuuu <https://github.com/biuuu> (genshin-wish-export, star-rail-warp-export)",
    "earthjasonlin <https://github.com/earthjasonlin> (zzz-signal-search-export)",
    "Scighost <https://github.com/Scighost> (Starward Beyond / UIGF v4.2 reference)",
    "GoneTone <https://github.com/GoneTone> (genshin-impact-wish-gacha-analyzer Beyond reference)"
  ],
  "homepage": "https://github.com/h-void/hoyo-gacha-export",
  "repository": {
    "type": "git",
    "url": "https://github.com/h-void/hoyo-gacha-export.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "node .electron-vite/dev-runner.js",
    "test": "jest",
    "build": "cross-env BUILD_TARGET=clean node .electron-vite/build.js && electron-builder --publish never",
    "build:app": "cross-env BUILD_TARGET=clean node .electron-vite/build.js",
    "build:win32": "cross-env BUILD_TARGET=clean node .electron-vite/build.js && electron-builder --win --ia32 --publish never",
    "build:win64": "cross-env BUILD_TARGET=clean node .electron-vite/build.js && electron-builder --win --x64 --publish never",
    "build:linux": "cross-env BUILD_TARGET=clean node .electron-vite/build.js && electron-builder --linux --publish never",
    "build:mac": "node .electron-vite/patch-dmg-builder.js && cross-env BUILD_TARGET=clean node .electron-vite/build.js && electron-builder --mac --x64 --publish never && electron-builder --mac --arm64 --publish never",
    "build:dir": "cross-env BUILD_TARGET=clean node .electron-vite/build.js && electron-builder --dir --publish never",
    "build:clean": "cross-env BUILD_TARGET=onlyClean node .electron-vite/build.js",
    "build:web": "cross-env BUILD_TARGET=web node .electron-vite/build.js",
    "dev:web": "cross-env TARGET=web node .electron-vite/dev-runner.js",
    "start": "electron ./src/main/main.js",
    "build-update": "node .electron-vite/update.js",
    "dep:upgrade": "yarn upgrade-interactive --latest",
    "postinstall": "node .electron-vite/patch-dmg-builder.js && electron-builder install-app-deps"
  },
  "build": {
    "publish": null,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": false,
    "extraFiles": [],
    "productName": "HoYoGachaExport",
    "appId": "org.h-void.hoyo-gacha-export",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/electron/**/*"
    ],
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "mac": {
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": "zip"
    },
    "linux": {
      "target": "deb",
      "category": "Utility",
      "icon": "build/icons"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@element-plus/icons-vue": "^2.1.0",
    "@rollup/plugin-alias": "^3.1.9",
    "@rollup/plugin-commonjs": "^21.0.1",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^13.1.3",
    "@types/node": "^17.0.10",
    "@vitejs/plugin-vue": "2.1.0",
    "@vue/compiler-sfc": "^3.2.29",
    "adm-zip": "^0.5.9",
    "ajv": "8.17.1",
    "autoprefixer": "^10.4.2",
    "cfonts": "^2.10.0",
    "chalk": "^4.1.0",
    "cross-env": "^7.0.3",
    "del": "^6.0.0",
    "echarts": "^5.2.2",
    "electron": "^16.0.7",
    "electron-builder": "^23.0.2",
    "electron-fetch": "^1.7.4",
    "electron-unhandled": "^3.0.2",
    "electron-window-state": "^5.0.3",
    "element-plus": "^2.3.7",
    "fs-extra": "^10.0.0",
    "get-stream": "^6.0.1",
    "glob": "^10.3.3",
    "jest": "^29.5.0",
    "lodash-es": "^4.17.21",
    "moment": "^2.29.1",
    "multispinner": "^0.2.1",
    "ora": "^5.3.0",
    "portfinder": "^1.0.28",
    "postcss": "^8.4.5",
    "rollup": "^2.79.1",
    "rollup-plugin-esbuild": "^4.8.2",
    "semver": "^7.3.5",
    "tailwindcss": "^3.0.16",
    "vite": "2.7.13",
    "vue": "^3.2.29",
    "winreg": "^1.2.4",
    "yauzl": "^2.10.0"
  },
  "keywords": [
    "hoyoverse",
    "genshin-impact",
    "miliastra-wonderland",
    "star-rail",
    "zenless-zone-zero",
    "gacha",
    "uigf",
    "electron",
    "vue3",
    "vite"
  ]
}
