{
  "name": "hoyo-gacha-export",
  "version": "1.1.2",
  "description": "Unified HoYoverse PC gacha history exporter for Genshin Impact (Wish & Miliastra Wonderland), Honkai: Star Rail (Warp & Interstellar Collectibles), Zenless Zone Zero, Honkai Impact 3rd, and upcoming PC titles Petit Planet and Honkai: Nexus Anima.",
  "main": "./dist/electron/main/main.js",
  "author": "h-void <118628214+h-void@users.noreply.github.com>",
  "contributors": [
    "biuuu <https://github.com/biuuu> (genshin-wish-export, star-rail-warp-export)",
    "earthjasonlin <https://github.com/earthjasonlin> (zzz-signal-search-export)",
    "Scighost <https://github.com/Scighost> (Starward Beyond / UIGF v4.2 reference)",
    "GoneTone <https://github.com/GoneTone> (genshin-impact-wish-gacha-analyzer Beyond reference)",
    "Neroliu <https://github.com/Neroliu> & YUYUYUYU2147 <https://github.com/YUYUYUYU2147> (Honkai Impact 3rd bh3_self_help_query reference)"
  ],
  "homepage": "https://github.com/h-void/hoyo-gacha-export",
  "repository": {
    "type": "git",
    "url": "https://github.com/h-void/hoyo-gacha-export.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node .electron-vite/dev-runner.js",
    "test": "jest",
    "build": "cross-env BUILD_TARGET=clean node .electron-vite/build.js && electron-builder --publish never",
    "build:app": "cross-env BUILD_TARGET=clean node .electron-vite/build.js",
    "build:win64": "cross-env BUILD_TARGET=clean node .electron-vite/build.js && electron-builder --win --x64 --publish never",
    "build:win-arm64": "cross-env BUILD_TARGET=clean node .electron-vite/build.js && electron-builder --win --arm64 --publish never",
    "build:linux": "cross-env BUILD_TARGET=clean node .electron-vite/build.js && electron-builder --linux --publish never",
    "build:mac": "cross-env BUILD_TARGET=clean node .electron-vite/build.js && electron-builder --mac --x64 --publish never && electron-builder --mac --arm64 --publish never",
    "build:dir": "cross-env BUILD_TARGET=clean node .electron-vite/build.js && electron-builder --dir --publish never",
    "build:clean": "cross-env BUILD_TARGET=onlyClean node .electron-vite/build.js",
    "build:web": "cross-env BUILD_TARGET=web node .electron-vite/build.js",
    "dev:web": "cross-env TARGET=web node .electron-vite/dev-runner.js",
    "start": "electron ./src/main/main.js",
    "build-update": "node .electron-vite/update.js",
    "dep:upgrade": "yarn upgrade-interactive --latest",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "publish": null,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": false,
    "extraFiles": [],
    "productName": "HoYoGachaExport",
    "appId": "org.h-void.hoyo-gacha-export",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/electron/**/*"
    ],
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "mac": {
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": "zip"
    },
    "linux": {
      "target": "deb",
      "category": "Utility",
      "icon": "build/icons"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "chalk": "^4.1.2",
    "cross-env": "^10.1.0",
    "echarts": "^6.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-window-state": "^5.0.3",
    "element-plus": "^2.14.8",
    "esbuild": "^0.28.2",
    "fs-extra": "^11.4.1",
    "jest": "^30.5.2",
    "lodash-es": "^4.18.1",
    "portfinder": "^1.0.32",
    "rollup": "^4.68.7",
    "rollup-plugin-esbuild": "^6.2.1",
    "semver": "^7.8.6",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vue": "^3.5.46",
    "winreg": "^1.2.5"
  },
  "keywords": [
    "hoyoverse",
    "mihoyo",
    "genshin-impact",
    "miliastra-wonderland",
    "star-rail",
    "zenless-zone-zero",
    "honkai-impact-3rd",
    "petit-planet",
    "nexus-anima",
    "gacha",
    "uigf",
    "electron",
    "vue3",
    "vite"
  ]
}
